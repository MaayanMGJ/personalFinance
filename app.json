{
  "expo": {
    "name": "Ours",
    "slug": "personalfinance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "personalfinance",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.maayanmgj.personalfinance"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you attach a receipt photo to an expense.",
          "cameraPermission": "Lets you snap a receipt for an expense."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF6F1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
